server:
  name: icyloom
  host: 127.0.0.1
  instructions: IcyLoom réunit un cache LLM local et un tiroir de contexte compressé.
    ctx_store sort le gros du contexte et rend une ancre dense ; ctx_get rend les
    octets d'origine ; ctx_verify prouve qu'aucun invariant n'a été perdu. Les actions
    destructrices exigent confirm=true.
  remote_access_token: null
ports:
  gateway_http: 8150
  mcp_http: 8151
  mcp_sse: 8152
  admin: 8153
database:
  path: icyloom.db
  journal_mode: WAL
  busy_timeout_ms: 5000
  synchronous: NORMAL
cache:
  ttl_seconds: 604800
  max_entries: 50000
  semantic_enabled: false
  semantic_threshold: 0.95
  semantic_provider: ''
  semantic_url: ''
  semantic_collection: icyloom
compression:
  enabled: true
  profile: strict
  auto_store_threshold: 500
  max_anchor_chars: 6000
  max_invariants: 40
context:
  session_ttl_days: 30
  redact_enabled: true
  rate_limit_per_minute: 120
  allowed_dirs:
  - D:\Icy-Loom
  - C:\Users\Tech\AppData\Local\hermes\cache\scratch
  - C:\Users\Tech\AppData\Local\hermes
  audit_enabled: true
  audit_retention_days: 30
  sandbox_enabled: true
  sandbox_timeout_seconds: 30.0
breaker:
  failure_threshold: 3
  reset_seconds: 30.0
  half_open_probes: 1
ledger:
  enabled: true
  retention_days: 90
tool_proxy:
  default_ttl_seconds: 3600
  loop_window_seconds: 300
  loop_warn_after: 3
  loop_block_after: 5
  loop_max_cycle: 3
  max_result_bytes: 1048576
  connect_timeout_seconds: 20.0
  call_timeout_seconds: 300.0
  servers: []
  catalog:
  - name: playwright
    command: npx
    args:
    - '@playwright/mcp@latest'
    description: Browser automation (Microsoft) - 82k recherches/mois
    cache_enabled: true
    ttl_seconds: 3600
    enabled: false
  - name: github
    command: npx
    args:
    - '@modelcontextprotocol/server-github'
    description: GitHub repos/PR/issues - 889k downloads
    cache_enabled: true
    ttl_seconds: 3600
    enabled: false
  - name: context7
