# =============================================================================
# IcyLoom — configuration unique.
# Tout le produit lit ce fichier : passerelle HTTP, serveur MCP, API admin,
# base SQLite, journal économique. Aucun autre fichier de configuration.
# Les chemins sont RELATIFS (résolus contre la racine du projet).
#
# Ce fichier est le DÉFAUT AUTONOME : il fonctionne sur n'importe quelle
# machine, sans LM Studio, sans Node, sans uvx, sans clé d'API.
# Les sections facultatives (upstreams LLM, serveurs d'outils MCP) sont
# commentées : décommentez-les si vous en avez besoin.
# =============================================================================

server:
  name: icyloom
  host: 127.0.0.1
  instructions: >-
    IcyLoom réunit un cache LLM local et un tiroir de contexte compressé.
    ctx_store sort le gros du contexte et rend une ancre dense ; ctx_get rend
    les octets d'origine ; ctx_verify prouve qu'aucun invariant n'a été perdu.
    Les actions destructrices exigent confirm=true.
  # Jeton optionnel pour autoriser un accès distant (vide = local seulement).
  remote_access_token: null

ports:
  gateway_http: 8150     # passerelle HTTP OpenAI/Anthropic
  mcp_http: 8151        # MCP streamable-HTTP
  mcp_sse: 8152         # MCP SSE
  admin: 8153           # API d'administration + métriques

database:
  path: icyloom.db      # relatif -> <projet>/var/ (ou dossier utilisateur)
  journal_mode: WAL
  busy_timeout_ms: 5000
  synchronous: NORMAL

cache:
  ttl_seconds: 604800   # 7 jours
  max_entries: 50000
  semantic_enabled: false   # opt-in : index vectoriel externe
  semantic_threshold: 0.95
  semantic_provider: ""
  semantic_url: ""
  semantic_collection: icyloom

compression:
  enabled: true         # ACTIVÉ (2026-11-01) : lossless strict, pour que le tiroir de contexte serve vraiment
  profile: strict       # strict = lossless ; balanced/aggressive = opt-in
  auto_store_threshold: 500
  max_anchor_chars: 6000
  max_invariants: 40

context:
  session_ttl_days: 30
  redact_enabled: true
  rate_limit_per_minute: 120
  allowed_dirs:         # ACTIVÉ (2026-11-01) : sandbox ouverte sur les racines de travail
    - D:\Icy-Loom
    - C:\Users\Tech\AppData\Local\hermes\cache\scratch
    - C:\Users\Tech\AppData\Local\hermes
  audit_enabled: true
  audit_retention_days: 30
  sandbox_enabled: true
  sandbox_timeout_seconds: 30.0

breaker:
  failure_threshold: 3
  reset_seconds: 30.0   # réarmement RÉEL après ce délai
  half_open_probes: 1

ledger:
  enabled: true
  retention_days: 90

tool_proxy:
  default_ttl_seconds: 3600
  loop_window_seconds: 300
  loop_warn_after: 3
  loop_block_after: 5
  loop_max_cycle: 3
  max_result_bytes: 1048576
  connect_timeout_seconds: 20.0
  call_timeout_seconds: 300.0
