# Upstreams LLM : routage par priorité (préfixe d'URL > en-tête > corps > défaut).
# Aucun nom propre à un client particulier : uniquement base_url + clé d'env.
# Vide = relais LLM inactif (la base, le cache et le tiroir de contexte
# fonctionnent sans aucun fournisseur).
upstreams:
  # ACTIVÉ (2026-11-01) : upstream = Hermes (IcyCache :8080 -> omniroute/nous/...).
  # IcyLoom cache-devant le chemin Hermes : cache exact, SSE-safe, mesuré par le ledger.
  - name: hermes
    base_url: http://127.0.0.1:8080/v1
    priority: 10
    kind: openai
    api_key_env: HERMES_CUSTOM_OMNIROUTE_API_KEY
    timeout_seconds: 120.0
    sticky: true
    enabled: true
